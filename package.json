{
  "name": "focus-reader",
  "version": "0.1.0",
  "description": "An ADHD-friendly reading app: spotlight focus, bionic text, reading sprints, thought parking.",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.8.69"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.local.focusreader",
    "productName": "Focus Reader",
    "files": ["out/**/*", "package.json"],
    "mac": { "category": "public.app-category.productivity", "target": "dmg" }
  }
}
